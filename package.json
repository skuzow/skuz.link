{
  "name": "skuz.link",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "nuxi typecheck",
    "auth:schema": "better-auth generate --config server/utils/auth.ts --output server/database/schema/auth.ts -y",
    "db:generate": "drizzle-kit generate --config ./server/database/drizzle.config.ts",
    "db:migrate-local": "wrangler d1 migrations apply skuz-link-dev --local",
    "db:migrate-dev": "wrangler d1 migrations apply skuz-link-dev --remote",
    "db:migrate-pro": "wrangler d1 migrations apply skuz-link-pro --remote",
    "db:studio": "pnpm dlx d1s",
    "build": "nuxt build",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/robots": "5.6.7",
    "@nuxtjs/sitemap": "7.4.9",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-vue-next": "^0.556.0",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.4",
    "shadcn-nuxt": "2.4.2",
    "tailwind-merge": "^3.6.0",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@nuxt/eslint": "^1.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.6",
    "d1s": "^0.2.13",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "nitro-cloudflare-dev": "^0.2.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.131.1"
  },
  "packageManager": "pnpm@12.4.1"
}
