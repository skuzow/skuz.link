{
  "name": "skuz.link",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "nuxi typecheck",
    "test": "vitest run",
    "auth:schema": "better-auth generate --config layers/auth/server/infrastructure/better-auth.ts --output layers/auth/server/infrastructure/schema.ts -y && prettier --write layers/auth/server/infrastructure/schema.ts",
    "db:generate": "drizzle-kit generate --config ./server/database/drizzle.config.ts",
    "db:migrate-local": "wrangler d1 migrations apply db --local",
    "db:migrate-dev": "wrangler d1 migrations apply db --remote --preview",
    "db:migrate-pro": "wrangler d1 migrations apply db --remote",
    "db:studio": "pnpm dlx d1s",
    "build": "nuxt build",
    "dev:worker": "wrangler dev",
    "preview": "wrangler preview --name dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^4.1.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/robots": "7.0.2",
    "@nuxtjs/sitemap": "9.1.0",
    "@vueuse/core": "^15.0.0",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.3",
    "reka-ui": "^2.11.0",
    "shadcn-nuxt": "2.9.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/pixelarticons": "^1.2.10",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@vue/test-utils": "^2.5.1",
    "auth": "^1.7.15",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "h3": "^1.15.11",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "miniflare": "5.20261101.0-beta",
    "nitro-cloudflare-dev": "^0.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "unimport": "^7.0.2",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-markdown": "^32.1.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.156.1"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
